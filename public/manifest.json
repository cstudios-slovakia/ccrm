    },
    {
      "name": "New voice task",
      "short_name": "Voice task",
      "description": "Record a task by voice",
      "url": "/#tasks?voice=1",
      "icons": [{ "src": "/icon_192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "New task",
