#!/usr/bin/env php
<?php
/**
 * CCRM CLI Update & Management Tool
 */

if (php_sapi_name() !== 'cli') {
    die("This script can only be run from the command line.\n");
}

$args = $argv;
$command = isset($args[1]) ? $args[1] : 'help';

switch ($command) {
    case 'update':
        ccrm_update();
        break;
    case 'migrate':
        ccrm_migrate();
        break;
    case 'license':
    case 'licence':
        ccrm_license_cli(isset($args[2]) ? $args[2] : 'status', isset($args[3]) ? $args[3] : null);
        break;
    case 'help':
    default:
        ccrm_help();
        break;
}

function ccrm_help() {
    echo "CCRM CLI Tool\n";
    echo "Usage:\n";
    echo "  php ccrm update            - Pulls latest code, runs composer install, publishes assets, and migrates DB\n";
    echo "  php ccrm migrate           - Runs database migrations manually\n";
    echo "  php ccrm license status    - Shows this installation's licence and whether it allows updates\n";
    echo "  php ccrm license set <key> - Activates a licence key (or imports an offline licence token)\n";
    echo "  php ccrm license check     - Forces an immediate re-check with the licence server\n";
    echo "  php ccrm help              - Shows this help message\n";
}

/**
 * Load config.php + the schema + the licensing client and open a connection.
 * Returns a PDO, or null when this checkout is not installed / reachable —
 * callers decide whether that is fatal.
 */
function ccrm_cli_pdo() {
    global $pdo, $db_connection_error;

    $configFile = __DIR__ . '/config.php';
    if (!file_exists($configFile)) {
        $configFile = __DIR__ . '/public/config.php';
    }
    if (!file_exists($configFile)) {
        return null;
    }
    require_once $configFile;
    if (!function_exists('get_db_connection')) {
        return null;
    }

    foreach (['/api', '/dist/api', '/public/api'] as $dir) {
        if (file_exists(__DIR__ . $dir . '/license_client.php')) {
            require_once __DIR__ . $dir . '/schema.php';
            require_once __DIR__ . $dir . '/license_client.php';
            break;
        }
    }

    try {
        $pdo = get_db_connection();
        // The licences table may not exist yet on an install that has not been
        // migrated since licensing shipped.
        if (function_exists('ccrm_apply_schema')) {
            ccrm_apply_schema($pdo);
        }
        return $pdo;
    } catch (\Throwable $e) {
        echo "Error: could not connect to the database: " . $e->getMessage() . "\n";
        return null;
    }
}

/** Human wording for the status codes ccrm_license_state() produces. */
function ccrm_license_describe($code) {
    $map = [
        'unconfigured' => 'licensing is not configured in this build',
        'none'         => 'no licence key has been entered on this installation',
        'invalid'      => 'the stored licence does not verify for this installation',
        'revoked'      => 'the licence has been revoked',
        'suspended'    => 'the licence is suspended',
        'expired'      => 'the licence has expired',
        'expiring'     => 'the licence is valid but expires soon',
        'active'       => 'the licence is valid',
        'stale_check'  => 'the licence has not been confirmed with the licence server for too long',
        'not_configured' => 'licensing is not configured in this build',
    ];
    return isset($map[$code]) ? $map[$code] : (string) $code;
}

function ccrm_license_print_state(array $state) {
    echo "  Status:        " . $state['status'] . " (" . ccrm_license_describe($state['status']) . ")\n";
    if (!empty($state['keyMasked'])) {
        echo "  Key:           " . $state['keyMasked'] . "\n";
    }
    if (!empty($state['customer'])) {
        echo "  Licensed to:   " . $state['customer'] . "\n";
    }
    if (!empty($state['expiresAt'])) {
        echo "  Expires:       " . $state['expiresAt']
            . ($state['daysRemaining'] !== null ? " (" . $state['daysRemaining'] . " day(s))" : "") . "\n";
    }
    if ($state['maxUsers'] !== null) {
        echo "  Seats:         " . $state['seatsUsed'] . " of " . $state['maxUsers'] . "\n";
    }
    if (!empty($state['lastCheckAt'])) {
        echo "  Last checked:  " . $state['lastCheckAt'] . "\n";
    }
    if (!empty($state['lastError'])) {
        echo "  Last error:    " . $state['lastError'] . "\n";
    }
    echo "  Updates:       " . ($state['updatesAllowed'] ? "allowed" : "BLOCKED — " . ccrm_license_describe($state['updatesBlockedReason'])) . "\n";
}

function ccrm_license_cli($sub, $value) {
    $pdo = ccrm_cli_pdo();
    if ($pdo === null) {
        echo "Error: CCRM is not installed here (no config.php), or the database is unreachable.\n";
        exit(1);
    }
    if (!function_exists('ccrm_license_state')) {
        echo "Error: the licensing client (api/license_client.php) was not found in this checkout.\n";
        exit(1);
    }

    switch ($sub) {
        case 'set':
            if ($value === null || trim($value) === '') {
                echo "Usage: php ccrm license set <licence-key|licence-token>\n";
                exit(1);
            }
            $input = trim($value);
            // One argument, two shapes — the same rule the HTTP endpoint uses.
            $looksLikeToken = (substr_count($input, '.') === 1 && strlen($input) > 80);
            echo $looksLikeToken
                ? "Importing an offline licence token...\n"
                : "Activating licence key with the licence server...\n";
            $result = $looksLikeToken
                ? ccrm_license_import_token($pdo, $input, null)
                : ccrm_license_activate($pdo, $input, null);
            if (!$result['ok']) {
                echo "Failed: " . $result['error'] . "\n";
                ccrm_license_print_state(ccrm_license_state($pdo));
                exit(1);
            }
            echo "Licence stored.\n";
            ccrm_license_print_state(ccrm_license_state($pdo));
            break;

        case 'check':
            echo "Re-checking with the licence server...\n";
            $result = ccrm_license_refresh($pdo, true);
            if (!$result['ok']) {
                echo "Check failed: " . $result['error'] . " (the cached licence stays in effect)\n";
            } else {
                echo "Licence confirmed.\n";
            }
            ccrm_license_print_state(ccrm_license_state($pdo));
            if (!$result['ok']) {
                exit(1);
            }
            break;

        case 'status':
        default:
            ccrm_license_print_state(ccrm_license_state($pdo));
            break;
    }
}

function ccrm_update() {
    echo "Starting CCRM Update Process...\n";

    // Deploy branch: defaults to `main` (what production instances pull). A
    // non-production box (staging/demo) can temporarily track a feature branch
    // instead by exporting CCRM_DEPLOY_BRANCH=<branch> before running update.
    // Unset it (or set it back to `main`) to return to the production branch.
    $branch = trim((string) getenv('CCRM_DEPLOY_BRANCH'));
    if ($branch === '') {
        $branch = 'main';
    }
    echo "Deploy branch: $branch\n";

    // 0. Licence gate.
    //
    // This is the ONLY thing a licence controls. Nothing below this point
    // touches the running application, and nothing anywhere else in the product
    // is disabled by an expired or missing licence — an install that stops
    // updating keeps serving its users exactly as it did yesterday.
    //
    // Deliberately fail-OPEN in three situations, because refusing to update is
    // also a way to leave a customer stuck on a version with a security bug:
    //   - licensing is not configured in this build (no public key compiled in);
    //   - CCRM is not installed here yet (no config.php / no database);
    //   - the licence server is unreachable but the cached, signed claim is
    //     still inside its validity and its offline window.
    // The last two are handled inside ccrm_license_gate_update().
    $licensePdo = ccrm_cli_pdo();
    if ($licensePdo !== null && function_exists('ccrm_license_gate_update')) {
        echo "Checking licence...\n";
        $gate = ccrm_license_gate_update($licensePdo);
        $state = $gate['state'];
        if (!$gate['allowed']) {
            echo "\n";
            echo "Update refused: " . ccrm_license_describe($gate['reason']) . ".\n";
            ccrm_license_print_state($state);
            echo "\n";
            echo "Enter a licence key in Settings -> Licence, or run:\n";
            echo "  php ccrm license set <licence-key>\n";
            echo "\n";
            echo "The application itself is unaffected and keeps running normally.\n";
            exit(1);
        }
        if ($state['status'] === 'expiring') {
            echo "Licence valid, expires " . $state['expiresAt']
                . " (" . $state['daysRemaining'] . " day(s) left).\n";
        } elseif ($state['status'] === 'unconfigured') {
            echo "Licence check skipped: licensing is not configured in this build.\n";
        } else {
            echo "Licence OK.\n";
        }
    } else {
        echo "Licence check skipped (CCRM is not installed here yet).\n";
    }

    // Snapshot the version we're on before pulling, so the final summary can
    // report what changed. Read from source rather than requiring/building it
    // (there is no build step on the server).
    $versionFile = __DIR__ . '/src/utils/version.ts';
    $oldVersion = ccrm_read_version($versionFile);


    // 1. Check for local modifications blocking git pull
    echo "Checking git status...\n";
    exec("git diff --name-only", $dirtyFiles);
    exec("git diff --cached --name-only", $stagedFiles);
    $dirty = array_unique(array_filter(array_merge($dirtyFiles, $stagedFiles)));

    // Files that are EXPECTED to go dirty on the server and are always safe to
    // discard (via `git checkout --`, never stash — see the danger note below):
    //
    //  - index.html: overwritten every build by the dist/ copy with
    //    build-specific markup, so the root copy differs from git.
    //  - vendor/composer/installed.php: `composer install` (step 3) re-stamps it
    //    with the current git commit hash on every run, so it goes dirty each
    //    time and would otherwise block the *next* `php ccrm update`.
    //  - the entire dist/ tree: this is generated frontend build output,
    //    committed byte-for-byte from the build machine. The server has no build
    //    step and never legitimately hand-edits it, so the pulled version is
    //    always authoritative. Line-ending normalization or a stale FTP/rsync
    //    upload over the checkout can leave these hashed assets "modified"; that
    //    is noise, not a real change worth blocking a deploy over.
    //  - every root file that also exists under public/ (api/*.php, sync.php,
    //    upload.php, sw.js, manifest.json, icons, .htaccess, ...): the repo root
    //    IS the docroot, and step 4 below publishes public/ -> dist/ -> root on
    //    every run. The root copy is therefore publish OUTPUT, not input — its
    //    git content is irrelevant because publish overwrites it moments later.
    //    If a commit ever edits public/api/x.php without mirroring it to
    //    api/x.php, the publish leaves the root copy permanently "modified" and
    //    every subsequent update would refuse to run, with nothing on the server
    //    to blame (this blocked deploys after v1.8.28/v1.8.30 for
    //    api/agent_utils.php). Discarding is the correct resolution: git — and
    //    specifically public/ — always wins. `npm run build` now runs
    //    scripts/sync-backend.mjs so the two copies cannot drift in a commit;
    //    this branch is the belt to that braces, and the drift warning after the
    //    pull below reports it if it ever happens again.
    $isAutoRestore = function ($file) {
        static $exact = ['index.html', 'vendor/composer/installed.php'];
        if (in_array($file, $exact, true) || strpos($file, 'dist/') === 0) {
            return true;
        }
        // Publish output: a root path with a public/ counterpart. Files under
        // public/ itself are NOT publish output (nothing writes to public/), so
        // a dirty public/... must still stop the update.
        return strpos($file, 'public/') !== 0
            && $file !== ''
            && file_exists(__DIR__ . '/public/' . $file);
    };
    $toRestore = array_filter($dirty, $isAutoRestore);
    if (!empty($toRestore)) {
        foreach ($toRestore as $file) {
            echo "Restoring $file to avoid conflict...\n";
            passthru("git checkout -- " . escapeshellarg($file));
        }
    }

    // Any OTHER dirty tracked file must NOT be auto-stashed: a stash created
    // here would get popped back after the pull below, re-applying whatever
    // stale local edit was sitting in the file ON TOP of the freshly-pulled
    // code — silently reverting the very fix the update was meant to deliver.
    // This is exactly what happened on 2026-07-10: a forgotten local edit to
    // sync.php kept resurrecting itself after every `php ccrm update`, masking
    // real fixes (including a data-loss guard) for days. Fail loudly instead
    // and make the operator resolve it explicitly. Note we never stash here at
    // all — auto-restored files above are DISCARDED, so nothing gets resurrected;
    // this branch only exists to stop on genuine backend/source edits (e.g.
    // api/error_logs.php, sync.php) that a human must resolve.
    $unexpectedDirty = array_values(array_filter($dirty, function ($f) use ($isAutoRestore) {
        return !$isAutoRestore($f);
    }));
    if (!empty($unexpectedDirty)) {
        echo "Error: unexpected local modifications to tracked file(s), refusing to auto-stash:\n";
        foreach ($unexpectedDirty as $file) {
            echo "  - $file\n";
        }
        echo "Inspect with `git diff`, then commit, `git stash`, or `git checkout --` each file\n";
        echo "manually before re-running `php ccrm update`.\n";
        exit(1);
    }

    // 2. Pull latest code
    echo "Pulling latest code from origin/$branch...\n";
    passthru("git pull origin " . escapeshellarg($branch), $pullResult);
    if ($pullResult !== 0) {
        echo "Error: git pull failed.\n";
        exit(1);
    }

    // 2b. Report (but do not block on) backend copies that drifted apart in the
    //     COMMIT itself — i.e. public/api/x.php and api/x.php holding different
    //     code in git. Publish resolves it in public/'s favour, so the deploy is
    //     still correct and consistent; it just means the repo is lying about
    //     what the root copy contains, and someone should run
    //     `npm run sync:backend` on the build machine and commit the result.
    ccrm_report_backend_drift();

    // 3. Run composer install
    echo "Running composer install to update dependencies...\n";
    passthru("composer install", $composerResult);
    if ($composerResult !== 0) {
        echo "Error: composer install failed.\n";
        exit(1);
    }

    // 3b. Audit dependencies for known vulnerabilities (non-fatal, informational).
    echo "Auditing PHP dependencies (composer audit)...\n";
    passthru("composer audit --no-interaction 2>&1", $auditResult);
    if ($auditResult !== 0) {
        echo "Warning: composer audit reported advisories above. Review before/after deploy.\n";
    }

    // 4. Publish assets (copy dist/* to root) if we are in a direct git clone deployment
    $isVendor = file_exists(__DIR__ . '/../../composer.json') && strpos(__DIR__, 'vendor/cstudios-slovakia') !== false;
    if (!$isVendor) {
        echo "Publishing built assets from dist/ to root directory...\n";
        require_once __DIR__ . '/src-php/Installer.php';
        // Refresh dist/ backend PHP from public/ (the tracked source of truth)
        // BEFORE publishing. Locally `vite build` copies public/* into dist/*,
        // but there is no build step on the server, so dist/*.php (e.g.
        // dist/sync.php, which is gitignored and never pulled) would otherwise
        // stay stale and overwrite the freshly-pulled root sync.php on publish.
        // This reproduces the build's public/->dist/ copy so backend fixes
        // actually reach the served root files.
        if (is_dir(__DIR__ . '/public')) {
            \CCRM\Installer::copyDir(__DIR__ . '/public', __DIR__ . '/dist', ['config.php']);

            // The copy above is only meant to refresh backend PHP. But public/
            // can also hold STALE frontend artifacts (a leftover index.html
            // pointing at an old bundle hash, plus old assets/), which would
            // clobber the freshly-pulled, git-tracked build in dist/ and make
            // the published index.html load a bundle that no longer matches the
            // deployed code. Restore the tracked frontend so the published
            // frontend is always exactly the one we just pulled. (Extra untracked
            // old bundles left in dist/assets are harmless — index.html points at
            // the correct hash.)
            passthru("git checkout -- dist/index.html dist/assets");
        }
        \CCRM\Installer::copyDir(__DIR__ . '/dist', __DIR__, ['config.php']);
    }

    // 5. Run database migrations
    ccrm_migrate();

    // 6. Optional post-deploy health check. Set CCRM_HEALTHCHECK_URL (or pass a
    //    URL as the 2nd CLI arg) to verify the live site responds after deploy.
    global $args;
    $healthUrl = getenv('CCRM_HEALTHCHECK_URL');
    if (empty($healthUrl) && !empty($args[2])) {
        $healthUrl = $args[2];
    }
    if (!empty($healthUrl) && function_exists('curl_init')) {
        echo "Running post-deploy health check: $healthUrl\n";
        $ch = curl_init($healthUrl);
        curl_setopt_array($ch, [
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_TIMEOUT        => 15,
            CURLOPT_FOLLOWLOCATION => true,
        ]);
        curl_exec($ch);
        $code = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
        curl_close($ch);
        if ($code >= 200 && $code < 400) {
            echo "Health check OK (HTTP $code).\n";
        } else {
            echo "WARNING: health check returned HTTP $code — verify the deployment.\n";
        }
    } else {
        echo "Tip: set CCRM_HEALTHCHECK_URL to enable an automatic post-deploy health check.\n";
    }

    $newVersion = ccrm_read_version($versionFile);
    if ($newVersion !== null && $oldVersion !== null && $oldVersion !== $newVersion) {
        $from = ccrm_color($oldVersion, '33'); // yellow: what we came from
        $to = ccrm_color($newVersion, '32');   // green: what we landed on
        echo "\n" . ccrm_color('Success!', '32') . " CCRM updated from version $from to the latest $to.\n";
    } elseif ($newVersion !== null) {
        echo "\n" . ccrm_color('Success!', '32') . " CCRM updated successfully. Already on the latest version (" . ccrm_color($newVersion, '32') . ").\n";
    } else {
        echo "\n" . ccrm_color('Success!', '32') . " CCRM updated successfully to the latest version.\n";
    }
}

// The backend PHP is committed twice: once under public/ (the source Vite
// copies into dist/) and once in the repo root (the docroot the server actually
// serves, refreshed from dist/ by the publish step). A commit that touches only
// one of the two makes the deployed code and the repo-root code disagree, so
// warn about it here — loudly, but without failing the deploy: publish already
// resolved it in public/'s favour, which is the correct code.
function ccrm_report_backend_drift() {
    $lines = [];
    exec("git ls-tree -r HEAD", $lines, $status);
    if ($status !== 0 || empty($lines)) {
        return;
    }

    $blobs = [];
    foreach ($lines as $line) {
        // "<mode> <type> <object>\t<path>"
        $parts = explode("\t", $line, 2);
        if (count($parts) !== 2) {
            continue;
        }
        $meta = preg_split('/\s+/', trim($parts[0]));
        if (count($meta) < 3) {
            continue;
        }
        $blobs[$parts[1]] = $meta[2];
    }

    // Mirrored by scripts/sync-backend.mjs -- keep the exclusions in step with it.
    $skip = ['index.html', 'assets/', 'update-screenshots/', 'config.php'];
    $drift = [];
    foreach ($blobs as $path => $hash) {
        if (strpos($path, 'public/') !== 0) {
            continue;
        }
        $rel = substr($path, strlen('public/'));
        foreach ($skip as $prefix) {
            if ($rel === $prefix || strpos($rel, $prefix) === 0) {
                continue 2;
            }
        }
        if (isset($blobs[$rel]) && $blobs[$rel] !== $hash) {
            $drift[] = $rel;
        }
    }

    if (empty($drift)) {
        return;
    }

    echo ccrm_color('Warning:', '33') . " committed backend copies disagree between public/ and the repo root:\n";
    foreach ($drift as $file) {
        echo "  - $file (serving public/$file)\n";
    }
    echo "The deploy is fine -- publish always uses public/ -- but the repo-root copy is stale.\n";
    echo "On the build machine run `npm run sync:backend` and commit the result.\n";
}

function ccrm_read_version($file) {
    if (!file_exists($file)) {
        return null;
    }
    $contents = file_get_contents($file);
    if ($contents !== false && preg_match('/VERSION\s*=\s*"([^"]+)"/', $contents, $m)) {
        return $m[1];
    }
    return null;
}

// Wraps text in an ANSI color code, but only when output is a real terminal
// (a TTY) that's likely to render it -- avoids dumping escape codes into log
// files or CI output when stdout is redirected.
function ccrm_color($text, $code) {
    $isTty = function_exists('posix_isatty') && defined('STDOUT') && posix_isatty(STDOUT);
    if (!$isTty) {
        return $text;
    }
    return "\033[{$code}m{$text}\033[0m";
}

function ccrm_migrate() {
    echo "Running database migrations...\n";
    
    // Require autoloader
    $autoloader = __DIR__ . '/vendor/autoload.php';
    if (!file_exists($autoloader)) {
        echo "Error: vendor/autoload.php not found. Please run composer install first.\n";
        exit(1);
    }
    require_once $autoloader;

    // Load config
    $configFile = __DIR__ . '/config.php';
    if (!file_exists($configFile)) {
        $configFile = __DIR__ . '/public/config.php';
    }
    
    if (!file_exists($configFile)) {
        echo "Warning: config.php not found. Skipping database migrations (setup wizard will handle this on first run).\n";
        return;
    }

    // Force connection variables to be loaded into global scope
    global $pdo, $db_connection_error;
    require_once $configFile;
    
    if (!function_exists('get_db_connection')) {
        echo "Error: get_db_connection() function not found in config.php.\n";
        exit(1);
    }

    $schemaFile = __DIR__ . '/dist/api/schema.php';
    if (!file_exists($schemaFile)) {
        $schemaFile = __DIR__ . '/public/api/schema.php';
    }
    require_once $schemaFile;

    try {
        $pdo = get_db_connection();
        ccrm_apply_schema($pdo);
        echo "Database schema migrated successfully.\n";
    } catch (\Exception $e) {
        echo "Error running database migration: " . $e->getMessage() . "\n";
        exit(1);
    }
}
