[
  { "name": "plain tag", "template": "Hello {{first_name}}!", "values": { "first_name": "Jana" }, "context": "html", "mode": "send", "expected": "Hello Jana!" },
  { "name": "spaces inside the braces", "template": "Hi {{ first_name }}!", "values": { "first_name": "Jana" }, "context": "html", "mode": "send", "expected": "Hi Jana!" },
  { "name": "fallback used when the value is missing", "template": "Hi {{first_name|there}}!", "values": {}, "context": "html", "mode": "send", "expected": "Hi there!" },
  { "name": "fallback with spaces is trimmed, empty value uses it", "template": "Hi {{ first_name | dear friend }}!", "values": { "first_name": "" }, "context": "html", "mode": "preview", "expected": "Hi dear friend!" },
  { "name": "value wins over the fallback", "template": "Hi {{first_name|there}}!", "values": { "first_name": "Jana" }, "context": "text", "mode": "send", "expected": "Hi Jana!" },
  { "name": "null value counts as empty", "template": "Hi {{first_name|there}}!", "values": { "first_name": null }, "context": "text", "mode": "send", "expected": "Hi there!" },
  { "name": "empty value without fallback in send mode", "template": "Hi {{first_name}}!", "values": { "first_name": "" }, "context": "html", "mode": "send", "expected": "Hi !" },
  { "name": "empty value without fallback in preview mode stays", "template": "Hi {{first_name}}!", "values": { "first_name": "" }, "context": "html", "mode": "preview", "expected": "Hi {{first_name}}!" },
  { "name": "missing value in send mode", "template": "Hi {{first_name}}!", "values": {}, "context": "html", "mode": "send", "expected": "Hi !" },
  { "name": "missing value in preview mode stays", "template": "Hi {{first_name}}!", "values": {}, "context": "html", "mode": "preview", "expected": "Hi {{first_name}}!" },
  { "name": "html context escapes like htmlspecialchars ENT_QUOTES", "template": "<p>{{company}}</p>", "values": { "company": "Tom & \"Jerry\" <b>'s" }, "context": "html", "mode": "send", "expected": "<p>Tom &amp; &quot;Jerry&quot; &lt;b&gt;&#039;s</p>" },
  { "name": "html context escapes the fallback too", "template": "{{x|a<b & 'c'}}", "values": {}, "context": "html", "mode": "send", "expected": "a&lt;b &amp; &#039;c&#039;" },
  { "name": "text context does not escape", "template": "{{company}}", "values": { "company": "Tom & \"Jerry\" <b>'s" }, "context": "text", "mode": "send", "expected": "Tom & \"Jerry\" <b>'s" },
  { "name": "text context does not escape the fallback", "template": "{{x|a<b & 'c'}}", "values": {}, "context": "text", "mode": "preview", "expected": "a<b & 'c'" },
  { "name": "unknown tag stays in preview mode", "template": "{{nope}} and {{first_name}}", "values": { "first_name": "Jana" }, "context": "html", "mode": "preview", "expected": "{{nope}} and Jana" },
  { "name": "unknown tag is empty in send mode", "template": "{{nope}} and {{first_name}}", "values": { "first_name": "Jana" }, "context": "html", "mode": "send", "expected": " and Jana" },
  { "name": "unknown tag with a fallback uses it in preview mode", "template": "{{nope|x}}", "values": {}, "context": "html", "mode": "preview", "expected": "x" },
  { "name": "several tags in one string", "template": "{{first_name}} / {{name}} / <{{email}}> / {{company|none}}", "values": { "first_name": "Jana", "name": "Jana Nováková", "email": "jana@example.com" }, "context": "text", "mode": "send", "expected": "Jana / Jana Nováková / <jana@example.com> / none" },
  { "name": "tag inside an href attribute", "template": "<a href=\"{{unsubscribe_url}}\">Unsubscribe</a>", "values": { "unsubscribe_url": "https://x.test/api/newsletter_public.php?a=unsubscribe&t=abc" }, "context": "html", "mode": "send", "expected": "<a href=\"https://x.test/api/newsletter_public.php?a=unsubscribe&amp;t=abc\">Unsubscribe</a>" },
  { "name": "tag as an href with a fallback", "template": "<a href=\"{{view_online_url|https://example.com}}\">View</a>", "values": {}, "context": "html", "mode": "send", "expected": "<a href=\"https://example.com\">View</a>" },
  { "name": "unicode values", "template": "Ahoj {{first_name}} z {{company}}", "values": { "first_name": "Žofia", "company": "Ľudovít & syn Šťastný" }, "context": "html", "mode": "send", "expected": "Ahoj Žofia z Ľudovít &amp; syn Šťastný" },
  { "name": "unicode fallback", "template": "Kedves {{first_name|Ügyfelünk}}!", "values": {}, "context": "html", "mode": "send", "expected": "Kedves Ügyfelünk!" },
  { "name": "a space-only value is a value", "template": "[{{x}}]", "values": { "x": " " }, "context": "text", "mode": "send", "expected": "[ ]" },
  { "name": "a fallback may contain a pipe", "template": "{{x|a|b}}", "values": {}, "context": "text", "mode": "send", "expected": "a|b" },
  { "name": "text that is not a valid tag is left alone", "template": "{{ first name }} {{}} {first_name} {{{first_name}}", "values": { "first_name": "Jana" }, "context": "html", "mode": "send", "expected": "{{ first name }} {{}} {first_name} {Jana" },
  { "name": "the same tag twice", "template": "{{name}}, {{name}}", "values": { "name": "A&B" }, "context": "html", "mode": "send", "expected": "A&amp;B, A&amp;B" },
  { "name": "html: a pre-escaped fallback is decoded then escaped once", "template": "{{first_name|Tom &amp; Jerry}}", "values": {}, "context": "html", "mode": "send", "expected": "Tom &amp; Jerry" },
  { "name": "html: an href fallback with &amp; in the query string", "template": "<a href=\"{{view_online_url|https://x.test/p?a=1&amp;b=2}}\">View</a>", "values": {}, "context": "html", "mode": "send", "expected": "<a href=\"https://x.test/p?a=1&amp;b=2\">View</a>" },
  { "name": "html: every entity of the fallback decode map", "template": "{{x|&lt;b&gt; &quot;q&quot; &#039;a&#39; &apos;b&apos;&nbsp;c}}", "values": {}, "context": "html", "mode": "send", "expected": "&lt;b&gt; &quot;q&quot; &#039;a&#039; &#039;b&#039; c" },
  { "name": "html: the fallback is decoded in one pass only", "template": "{{x|&amp;lt; &amp;amp;}}", "values": {}, "context": "html", "mode": "send", "expected": "&amp;lt; &amp;amp;" },
  { "name": "html: entities outside the decode map stay text and are escaped", "template": "{{x|&copy; &#169; &AMP; &#x26;}}", "values": {}, "context": "html", "mode": "send", "expected": "&amp;copy; &amp;#169; &amp;AMP; &amp;#x26;" },
  { "name": "html: a fallback in preview mode is decoded and escaped the same way", "template": "{{x|Tom &amp; Jerry}}", "values": {}, "context": "html", "mode": "preview", "expected": "Tom &amp; Jerry" },
  { "name": "html: a value is never decoded, only escaped", "template": "{{company}}", "values": { "company": "Tom &amp; Jerry &lt;" }, "context": "html", "mode": "send", "expected": "Tom &amp;amp; Jerry &amp;lt;" },
  { "name": "html: a value wins over a pre-escaped fallback", "template": "{{company|Tom &amp; Jerry}}", "values": { "company": "A & B" }, "context": "html", "mode": "send", "expected": "A &amp; B" },
  { "name": "text: a pre-escaped fallback is used as written", "template": "{{first_name|Tom &amp; Jerry}}", "values": {}, "context": "text", "mode": "send", "expected": "Tom &amp; Jerry" },
  { "name": "text: the fallback is neither decoded nor escaped", "template": "{{x|&lt;b&gt; <i> &nbsp; \"q\" 'a'}}", "values": {}, "context": "text", "mode": "send", "expected": "&lt;b&gt; <i> &nbsp; \"q\" 'a'" },
  { "name": "text: an href-like fallback with &amp; is used as written", "template": "{{view_online_url|https://x.test/p?a=1&amp;b=2}}", "values": {}, "context": "text", "mode": "send", "expected": "https://x.test/p?a=1&amp;b=2" },
  { "name": "ASCII whitespace inside the braces: tab, CR and LF are allowed", "template": "{{\tfirst_name\r\n}} {{\nfirst_name\t|\tx\n}}", "values": { "first_name": "Jana" }, "context": "text", "mode": "send", "expected": "Jana Jana" },
  { "name": "NBSP before the tag name is not whitespace: the text is not a tag", "template": "{{ first_name}}", "values": { "first_name": "Jana" }, "context": "text", "mode": "send", "expected": "{{ first_name}}" },
  { "name": "NBSP after the tag name is not whitespace: the text is not a tag", "template": "{{first_name }} {{first_name |x}}", "values": { "first_name": "Jana" }, "context": "html", "mode": "send", "expected": "{{first_name }} {{first_name |x}}" },
  { "name": "vertical tab and form feed are not whitespace inside the braces", "template": "{{\u000bfirst_name}} {{first_name\u000c}}", "values": { "first_name": "Jana" }, "context": "text", "mode": "send", "expected": "{{\u000bfirst_name}} {{first_name\u000c}}" },
  { "name": "the fallback is trimmed with ASCII whitespace only: NBSP stays", "template": "[{{x| \t a \r\n}}]", "values": {}, "context": "text", "mode": "send", "expected": "[ a ]" },
  { "name": "a fallback of only NBSP is a fallback, not empty", "template": "[{{x| }}]", "values": {}, "context": "text", "mode": "send", "expected": "[ ]" },
  { "name": "an ASCII-whitespace-only fallback is empty in send mode", "template": "[{{x| \t }}]", "values": {}, "context": "text", "mode": "send", "expected": "[]" }
]
