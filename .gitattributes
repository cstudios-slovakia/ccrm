# Normalize line endings: LF in the repository and in the working tree.
* text=auto eol=lf

# Windows scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.zip binary
*.pdf binary

# Stored with CRLF in the index. Without -text they would show as modified forever once
# touched. Convert each in a dedicated commit when no session is editing it, then drop the line.
/src/components/TaskDashboardView.tsx -text
/scrapbook/koperniq-ticket-spec.html -text

# Built frontend bundle: ship byte-for-byte, never normalize line endings.
/dist/assets/** -text
