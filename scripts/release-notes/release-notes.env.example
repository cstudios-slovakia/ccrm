# Settings for running the pipeline BY HAND on a PC (the cloud routine does not
# read this file — it gets the same values from its cloud environment).
# Copy to .release-notes/.env (gitignored); never commit a real token.

# Craft site the ccrm-news module answers on.
CRAFT_NEWS_BASE=https://ccrm.softwaresolutions.sk

# Same value as CCRM_NEWS_API_TOKEN in Craft's .env.
CRAFT_NEWS_TOKEN=

# live = publish immediately; draft = save the entry disabled.
RELEASE_NOTES_PUBLISH=draft
