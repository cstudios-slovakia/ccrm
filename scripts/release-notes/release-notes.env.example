# Release-notes pipeline settings. install-schedule.ps1 copies this file to
# .release-notes/.env (gitignored); edit that copy, never commit a real token.

# Craft site the ccrm-news module answers on.
CRAFT_NEWS_BASE=https://ccrm.softwaresolutions.sk

# Same value as CCRM_NEWS_API_TOKEN in Craft's .env — at least 32 random characters.
# PowerShell: -join ((1..48) | % { [char[]]'abcdefghijkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789' | Get-Random })
CRAFT_NEWS_TOKEN=

# live = publish immediately; draft = save the entry disabled, enable it in the Craft CP.
# Start with draft until the first two or three articles look right.
RELEASE_NOTES_PUBLISH=draft

# Model for the writing agent (claude --model). Empty = your Claude Code default.
RELEASE_NOTES_MODEL=opus
