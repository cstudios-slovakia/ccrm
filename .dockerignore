# Keeps the Docker build context small. The builder stage runs `npm ci` and
# `npm run build` (sync-backend.mjs, tsc -b, vite build), which only needs
# package*.json, src/, public/, index.html, scripts/, the config files and the
# root backend PHP. Without this file every rebuild uploaded node_modules/,
# .git/ and the QA output first, which took over ten minutes.

# Reinstalled by `npm ci` / regenerated by `npm run build` inside the image
node_modules
dist
vendor

# Version control and local tooling
.git
.github
.claude
.agents
.agent
.build-head-*
.vscode
.idea

# Test and QA output, test sources (tsc -b only checks src/ and vite.config.ts)
tests
test-results
playwright-report
presentation-screenshots
design-screenshots
design-system
*.zip
*.log

# Runtime data and secrets — config.php and uploads/ are bind-mounted by
# docker-compose.yml, never baked into the image
uploads
config.php
**/config.php
.env
.env.*
ccrm-license-private.json
**/ccrm-license-private.json
api_key.txt
**/api_key.txt
docker-compose.override.yml
