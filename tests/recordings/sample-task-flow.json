{
  "title": "Task Creation and Deadline Time Check",
  "steps": [
    {
      "type": "setViewport",
      "width": 1280,
      "height": 800,
      "deviceScaleFactor": 1,
      "isMobile": false,
      "hasTouch": false,
      "isLandscape": false
    },
    {
      "type": "navigate",
      "url": "http://localhost:5173/#dashboard"
    },
    {
      "type": "click",
      "selectors": [
        [".grid div.cursor-pointer"],
        ["button:has-text('Pridať úlohu')"]
      ]
    },
    {
      "type": "click",
      "selectors": [
        ["button:has-text('Pridať úlohu')"],
        ["button:has-text('Add Task')"]
      ]
    },
    {
      "type": "change",
      "selectors": [
        ["input[type='text']"]
      ],
      "value": "QA Recorded Flow Task"
    },
    {
      "type": "click",
      "selectors": [
        ["button:has-text('Vysoká')"],
        ["button:has-text('High')"]
      ]
    }
  ]
}
