{
  "title": "Dashboard: create task, fill every field, open Čas",
  "steps": [
    {
      "type": "setViewport",
      "width": 1440,
      "height": 900,
      "deviceScaleFactor": 1,
      "isMobile": false,
      "hasTouch": false,
      "isLandscape": false
    },
    {
      "type": "navigate",
      "url": "http://localhost:5173/#dashboard"
    },
    {
      "type": "click",
      "target": "main",
      "selectors": [
        [
          "aria/Vytvoriť novú úlohu"
        ],
        [
          "text/Vytvoriť novú úlohu"
        ],
        [
          "aria/Create New Task"
        ],
        [
          "text/Create New Task"
        ]
      ]
    },
    {
      "type": "waitForElement",
      "selectors": [
        [
          "[data-quick-task-form]"
        ]
      ],
      "visible": true,
      "timeout": 8000
    },
    {
      "type": "change",
      "selectors": [
        [
          "#nt-name"
        ],
        [
          "[data-quick-task-form] textarea"
        ]
      ],
      "value": "Recorded QA task"
    },
    {
      "type": "change",
      "selectors": [
        [
          "[data-quick-task-form] input[type=\"date\"]"
        ]
      ],
      "value": "2026-09-10"
    },
    {
      "type": "click",
      "target": "main",
      "selectors": [
        [
          "xpath///span[normalize-space(.)=\"Čas\" or normalize-space(.)=\"Time\" or normalize-space(.)=\"Időpont\"]/following::button[@aria-haspopup=\"listbox\"][1]"
        ]
      ]
    },
    {
      "type": "waitForElement",
      "selectors": [
        [
          "[role=\"listbox\"]"
        ]
      ],
      "visible": true,
      "timeout": 5000
    }
  ]
}
